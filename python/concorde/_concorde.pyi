from typing import Dict, Generic, Optional, Sequence, SupportsIndex, Tuple, TypeVar, Union, final, overload

import numpy as np
from numpy.typing import NDArray

_FloatArray = NDArray[np.float64]
_BooleanMask = Union[NDArray[np.bool_], list[bool], Tuple[bool, ...]]
_ValueT = TypeVar("_ValueT", float, _FloatArray)

class IncompatibleUnitError(Exception): ...
class AffineUnitError(ValueError): ...

@final
class Unit:
    @property
    def components(self) -> Dict[str, float]: ...
    @property
    def dimensions(self) -> Tuple[float, float, float, float, float, float, float]: ...
    @property
    def is_affine(self) -> bool: ...
    @property
    def is_delta(self) -> bool: ...
    def get_exponent(self, name: str) -> Optional[float]: ...
    def is_compatible(self, other: Unit) -> bool: ...
    def __mul__(self, other: Unit, /) -> Unit: ...
    def __truediv__(self, other: Unit, /) -> Unit: ...
    def __pow__(self, exponent: float, modulo: Optional[int] = None, /) -> Unit: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

@final
class UnitRegistry:
    def __init__(self, *, load_defaults: bool = True) -> None: ...
    def parse(self, unit_string: str) -> Unit: ...
    def define_unit(
        self,
        name: str,
        dimensions: Sequence[float],
        scale: float,
        aliases: Optional[Sequence[str]] = None,
        *,
        offset: Optional[float] = None,
    ) -> None: ...
    def load_definitions(self, path: str) -> int: ...
    def load_definitions_from_string(self, toml_str: str) -> int: ...

@final
class UncertainValue(Generic[_ValueT]):
    def __init__(self, value: _ValueT, uncertainty: Union[float, _ValueT]) -> None: ...
    @property
    def value(self) -> _ValueT: ...
    @property
    def uncertainty(self) -> _ValueT: ...
    @property
    def variable_id(self) -> Optional[str]: ...
    def is_independent(self) -> bool: ...
    def to_json(self) -> str: ...
    @staticmethod
    def from_json(json: str) -> Union[UncertainValue[float], UncertainValue[_FloatArray]]: ...
    @overload
    def __getitem__(self: UncertainValue[_FloatArray], index: Union[slice, _BooleanMask], /) -> UncertainValue[_FloatArray]: ...
    @overload
    def __getitem__(self: UncertainValue[_FloatArray], index: SupportsIndex, /) -> UncertainValue[float]: ...
    @overload
    def __mul__(self, other: Union[UncertainValue[float], float], /) -> UncertainValue[_ValueT]: ...
    @overload
    def __mul__(self, other: UncertainValue[_FloatArray], /) -> UncertainValue[_FloatArray]: ...
    @overload
    def __rmul__(self, other: Union[UncertainValue[float], float], /) -> UncertainValue[_ValueT]: ...
    @overload
    def __rmul__(self, other: UncertainValue[_FloatArray], /) -> UncertainValue[_FloatArray]: ...
    @overload
    def __add__(self, other: Union[UncertainValue[float], float], /) -> UncertainValue[_ValueT]: ...
    @overload
    def __add__(self, other: UncertainValue[_FloatArray], /) -> UncertainValue[_FloatArray]: ...
    @overload
    def __radd__(self, other: Union[UncertainValue[float], float], /) -> UncertainValue[_ValueT]: ...
    @overload
    def __radd__(self, other: UncertainValue[_FloatArray], /) -> UncertainValue[_FloatArray]: ...
    @overload
    def __sub__(self, other: Union[UncertainValue[float], float], /) -> UncertainValue[_ValueT]: ...
    @overload
    def __sub__(self, other: UncertainValue[_FloatArray], /) -> UncertainValue[_FloatArray]: ...
    def __rsub__(self, other: float, /) -> UncertainValue[_ValueT]: ...
    @overload
    def __truediv__(self, other: Union[UncertainValue[float], float], /) -> UncertainValue[_ValueT]: ...
    @overload
    def __truediv__(self, other: UncertainValue[_FloatArray], /) -> UncertainValue[_FloatArray]: ...
    def __rtruediv__(self, other: float, /) -> UncertainValue[_ValueT]: ...
    def __neg__(self) -> UncertainValue[_ValueT]: ...
    def __pow__(self, n: float, modulo: None = None, /) -> UncertainValue[_ValueT]: ...
    def __repr__(self) -> str: ...

@final
class Quantity(Generic[_ValueT]):
    def __init__(self, value: UncertainValue[_ValueT], unit: Unit) -> None: ...
    @property
    def value(self) -> UncertainValue[_ValueT]: ...
    @property
    def unit(self) -> Unit: ...
    def to(self, unit: Unit) -> Quantity[_ValueT]: ...
    def to_base_unit(self) -> Quantity[_ValueT]: ...
    def to_json(self) -> str: ...
    @staticmethod
    def from_json(json: str, registry: UnitRegistry) -> Union[Quantity[float], Quantity[_FloatArray]]: ...
    @overload
    def __getitem__(self: Quantity[_FloatArray], index: Union[slice, _BooleanMask], /) -> Quantity[_FloatArray]: ...
    @overload
    def __getitem__(self: Quantity[_FloatArray], index: SupportsIndex, /) -> Quantity[float]: ...
    @overload
    def __mul__(self, other: Union[Quantity[float], float], /) -> Quantity[_ValueT]: ...
    @overload
    def __mul__(self, other: Quantity[_FloatArray], /) -> Quantity[_FloatArray]: ...
    def __rmul__(self, other: float, /) -> Quantity[_ValueT]: ...
    @overload
    def __add__(self, other: Quantity[float], /) -> Quantity[_ValueT]: ...
    @overload
    def __add__(self, other: Quantity[_FloatArray], /) -> Quantity[_FloatArray]: ...
    @overload
    def __sub__(self, other: Quantity[float], /) -> Quantity[_ValueT]: ...
    @overload
    def __sub__(self, other: Quantity[_FloatArray], /) -> Quantity[_FloatArray]: ...
    @overload
    def __truediv__(self, other: Union[Quantity[float], float], /) -> Quantity[_ValueT]: ...
    @overload
    def __truediv__(self, other: Quantity[_FloatArray], /) -> Quantity[_FloatArray]: ...
    def __rtruediv__(self, other: float, /) -> Quantity[_ValueT]: ...
    def __pos__(self) -> Quantity[_ValueT]: ...
    def __neg__(self) -> Quantity[_ValueT]: ...
    def __abs__(self) -> Quantity[_ValueT]: ...
    def __pow__(self, n: float, modulo: None = None, /) -> Quantity[_ValueT]: ...
    def __repr__(self) -> str: ...
